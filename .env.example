# OpenCode server URL (without an API path suffix)
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Use "auto" to detect the current API route layout, "none" for no prefix,
# or "/api" for older OpenCode servers that expose their API under /api.
OPENCODE_API_PREFIX=auto

# Optional HTTP Basic Auth credentials.
# Keep secrets in your local MCP client configuration or environment.
OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=replace-me
